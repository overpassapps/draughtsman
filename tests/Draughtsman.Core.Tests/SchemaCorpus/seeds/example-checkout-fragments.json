{
  "id": "doc_checkout_fragments",
  "schemaVersion": 1,
  "title": "Checkout with a fragment, a note, and a created participant",
  "type": "sequence",
  "nodes": [
    {
      "id": "p_user",
      "kind": "actor",
      "label": "Customer",
      "shape": "rounded"
    },
    {
      "id": "p_web",
      "kind": "participant",
      "label": "Web app",
      "shape": "rectangle"
    },
    {
      "id": "p_api",
      "kind": "participant",
      "label": "Orders API",
      "shape": "rectangle"
    },
    {
      "id": "p_pay",
      "kind": "participant",
      "label": "Payments",
      "shape": "rectangle"
    },
    {
      "id": "p_mail",
      "kind": "participant",
      "label": "Mailer",
      "shape": "rectangle"
    },
    {
      "id": "f_1",
      "kind": "fragment",
      "label": "alt",
      "shape": "rectangle",
      "props": {
        "operator": "alt",
        "operands": [
          "[card ok]",
          "[declined]"
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "m_1",
      "kind": "sync",
      "label": "Place order",
      "from": {
        "node": "p_user"
      },
      "to": {
        "node": "p_web"
      }
    },
    {
      "id": "m_2",
      "kind": "sync",
      "label": "POST /orders",
      "from": {
        "node": "p_web"
      },
      "to": {
        "node": "p_api"
      },
      "props": {
        "activate": true
      }
    },
    {
      "id": "n_1",
      "kind": "note",
      "label": "Idempotent by key",
      "from": {
        "node": "p_web"
      },
      "to": {
        "node": "p_api"
      }
    },
    {
      "id": "m_3",
      "kind": "sync",
      "label": "charge(total)",
      "from": {
        "node": "p_api"
      },
      "to": {
        "node": "p_pay"
      },
      "props": {
        "activate": true,
        "in": "f_1",
        "operand": 0
      }
    },
    {
      "id": "m_4",
      "kind": "return",
      "label": "receipt",
      "from": {
        "node": "p_pay"
      },
      "to": {
        "node": "p_api"
      },
      "props": {
        "deactivate": true,
        "in": "f_1",
        "operand": 0
      }
    },
    {
      "id": "m_5",
      "kind": "async",
      "label": "declined",
      "from": {
        "node": "p_api"
      },
      "to": {
        "node": "p_web"
      },
      "props": {
        "in": "f_1",
        "operand": 1
      }
    },
    {
      "id": "m_6",
      "kind": "return",
      "label": "201 Created",
      "from": {
        "node": "p_api"
      },
      "to": {
        "node": "p_web"
      },
      "props": {
        "deactivate": true
      }
    },
    {
      "id": "m_7",
      "kind": "create",
      "label": "new Mailer()",
      "from": {
        "node": "p_web"
      },
      "to": {
        "node": "p_mail"
      }
    },
    {
      "id": "m_8",
      "kind": "sync",
      "label": "send(receipt)",
      "from": {
        "node": "p_web"
      },
      "to": {
        "node": "p_mail"
      }
    },
    {
      "id": "m_9",
      "kind": "destroy",
      "label": "close()",
      "from": {
        "node": "p_web"
      },
      "to": {
        "node": "p_mail"
      }
    }
  ],
  "meta": {
    "createdAt": "2026-09-29T00:00:00.000Z",
    "updatedAt": "2026-09-29T00:00:00.000Z",
    "createdBy": "eric"
  }
}
