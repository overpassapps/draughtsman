{
  "name": "@draughtsman/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Draughtsman single-page app. Served by the Draughtsman server from web/dist.",
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "benchmark": "node scripts/generate-benchmark.ts",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "npm run tokens && vite preview",
    "lint": "npm run tokens && eslint .",
    "test": "npm run tokens && vitest run",
    "test:watch": "npm run tokens && vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
