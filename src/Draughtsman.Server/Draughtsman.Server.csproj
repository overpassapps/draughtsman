<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Draughtsman.Server</RootNamespace>
    <AssemblyName>draughtsman</AssemblyName>
    <Description>Draughtsman server: serves the SPA, REST API, WebSocket sync and MCP server from one self-contained binary.</Description>
    <!-- Self-contained single-file publish per ADR 0001. Runtime identifier is chosen at publish time (-r). -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The one place the Playwright version is written in this project (the Dockerfile pins the same number for its npm install).
         The server reports it in the install command it tells an admin to run (ChromiumPdfRenderer.InstallCommand). -->
    <PlaywrightVersion>1.63.0</PlaywrightVersion>
    <!-- Microsoft.Playwright has no Windows Arm64 driver, and for a runtime it does not know its build targets copy every platform's
         Node runtime (hundreds of megabytes). A win-arm64 archive carries the x64 driver, which Windows 11 on Arm runs under its
         x64 emulation, and Playwright asks for win32_x64 on every Windows (PlaywrightDriver.PlatformFolder). -->
    <PlaywrightPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-x64</PlaywrightPlatform>
    <!-- This product is run as a service or in a console, never hosted in IIS (an IIS site reverse-proxies to it, docs/deployment.md), so the
         SDK's IIS leftovers, web.config and the ASP.NET Core Module's in-process dll, stay out of the publish folder. -->
    <PublishIISAssets>false</PublishIISAssets>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PlaywrightVersion" Value="$(PlaywrightVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id password hashing (build-spec-v0.1.md section 7): .NET has no built-in Argon2, and this is the one
         new dependency the local sign-in task adds. Pure managed (no native binary to publish per RID), MIT licensed,
         and the most widely used .NET Argon2 implementation - see Draughtsman.Server.Auth.PasswordHasher. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Streamable HTTP hosting for the MCP tools (Draughtsman.Mcp); WithStdioServerTransport comes from ModelContextProtocol, referenced transitively through Draughtsman.Mcp. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Optional server-side PDF export (build-spec-v0.1.md section 7): headless Chromium drives the browser; no browser is bundled at build time. -->
    <PackageReference Include="Microsoft.Playwright" Version="$(PlaywrightVersion)" />
    <!-- Lets the published win-x64 executable run as a Windows service (draughtsman service install): UseWindowsService
         is a no-op unless the service control manager started the process, so it changes nothing on Linux, macOS or a
         console run. MIT, Microsoft. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!-- Playwright's PDF driver (Node runtime + the playwright package, the .playwright/ folder) must be real files beside the
       executable. By default the single-file bundler swallows the platform's `node` into the executable, to be self-extracted
       to ~/.net/draughtsman/<hash>/ without its execute bit and without the `package/` folder that stays beside the executable,
       so the driver was never complete anywhere (QA B1) and every build left ~137 MB behind (P24). Keeping the files out of
       the bundle leaves one complete, executable copy in the archive; ChromiumPdfRenderer points Playwright at it
       (PlaywrightDriver), and scripts/lib/archive-layout.sh asserts it. playwright.ps1 is the Windows installer script: a
       non-Windows archive does not carry it. -->
  <Target Name="KeepPlaywrightDriverBesideTheExecutable" AfterTargets="CopyPlaywrightFilesToOutput">
    <ItemGroup>
      <Content Update="@(Content)" Condition="'%(Content.NuGetPackageId)' == 'Microsoft.Playwright'" ExcludeFromSingleFile="true" />
      <_PlaywrightWindowsScript Include="@(Content)" Condition="'%(Content.NuGetPackageId)' == 'Microsoft.Playwright' AND '%(Content.Link)' == 'playwright.ps1' AND '$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))" />
      <Content Remove="@(_PlaywrightWindowsScript)" />
    </ItemGroup>
  </Target>

  <!-- The date this build was made, shown on the About page. Defaults to today (UTC); a release build pins it so the binary is reproducible:
       dotnet publish -p:DraughtsmanBuildDate=2026-10-14 -->
  <PropertyGroup>
    <DraughtsmanBuildDate Condition="'$(DraughtsmanBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</DraughtsmanBuildDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DraughtsmanBuildDate</_Parameter1>
      <_Parameter2>$(DraughtsmanBuildDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Draughtsman.Core\Draughtsman.Core.csproj" />
    <ProjectReference Include="..\Draughtsman.Sidecar\Draughtsman.Sidecar.csproj" />
    <ProjectReference Include="..\Draughtsman.Storage\Draughtsman.Storage.csproj" />
    <ProjectReference Include="..\Draughtsman.Mcp\Draughtsman.Mcp.csproj" />
    <ProjectReference Include="..\Draughtsman.Ai\Draughtsman.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Draughtsman.Server.Tests" />
  </ItemGroup>

  <!-- The shipped chrome themes and their logo/favicon assets travel with the server so an instance always has a
       theme to fall back to, even in the published single-file layout where the repository themes/ folder is absent.
       LogicalName fixes the lookup keys used by ChromeThemeLoader. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\themes\chrome.yaml" LogicalName="themes/chrome.yaml" />
    <EmbeddedResource Include="..\..\themes\chrome-example-client.yaml" LogicalName="themes/chrome-example-client.yaml" />
    <EmbeddedResource Include="..\..\themes\assets\*.svg" LogicalName="themes/assets/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
